<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="goa_background">#0B1622</color>

    <style name="Theme.Goa" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/goa_background</item>
    </style>

    <style name="Theme.Goa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/goa_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Goa</item>
    </style>
</resources>
