<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only (ADR-036). The hosts the app contacts are the group's sync
     server, the game server and GitHub Pages for its two public files (network.json, leaderboard.json;
     ADR-056). The debug build overrides this file (src/debug) to allow a local test server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
