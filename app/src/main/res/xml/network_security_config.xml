<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only (ADR-036). The one host the app contacts is the group's
     sync server. The debug build overrides this file (src/debug) to allow a local test server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
