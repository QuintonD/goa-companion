<?xml version="1.0" encoding="utf-8"?>
<!-- Group sync (ADR-025) goes phone to phone over Nearby; its permissions come from feature/sync's
     manifest. The servers the app talks to are the group's sync server (ADR-036) and the game server
     with its public files (ADR-056), over HTTPS only in release builds (network_security_config). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The group's sync server (ADR-036): WorkManager fetches and uploads the sealed document. Online
         games (ADR-056): the rooms, the leaderboard and a game's socket. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- An online game reconnects at once when the network returns, rather than waiting out its backoff. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WorkManager's foreground-worker support: server sync never runs as a foreground service
         (no setForeground, no expedited work), and the timer has none either (ADR-007). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".GoaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Goa.Splash">

        <!-- The code scanner (ADR-025) brings Google's datatransport usage logger; its CCT backend is
             the part that uploads. Without the backend's registration the logger has nowhere to send
             and drops its events, so INTERNET (for the sync server) doesn't switch it on (ADR-036). -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- WorkManager is started by GoaApplication (Configuration.Provider, Hilt workers), not by
             androidx.startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
            <!-- No emoji in the app's words; the system's font draws any in a player's name. Loading
                 EmojiCompat at every start costs a font lookup and a relayout of every text (ADR-057). -->
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A sync file opened from Files, Drive or a message, or shared to the app (ADR-025). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.dev.quinton.goa.sync" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.dev.quinton.goa.sync" />
            </intent-filter>
            <!-- File managers that only know the extension report octet-stream with the name in the path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.goasync" />
            </intent-filter>
            <!-- An online invite the web app or a message offers: goa-companion://play/<code> (ADR-056).
                 A custom scheme, because a project's Pages site can't hold a verified App Link's
                 assetlinks.json, which must be at the origin's root. Opens the room's lobby. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="goa-companion" android:host="play" />
            </intent-filter>
        </activity>
    </application>
</manifest>
