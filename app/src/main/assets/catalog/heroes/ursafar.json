  "faq": [
    {
      "question": "Does Ursafar gain coins for removing a minion on his Primary Red?",
      "answer": "No. Coins are only gained for defeating a Minion, not Removing one.",
      "source": "goa2-faq"
    },
    {
      "question": "Does the additional movement only apply to the card it is printed on?",
      "answer": "Yes. When Ursafar is enraged, his blue allows him to move further with that explicit action. It does not apply to any other cards (there is no “This round” indication).",
      "source": "goa2-faq"
    }
  ],
