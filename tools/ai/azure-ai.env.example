# Copy to ~/.config/goa-companion/secrets/azure-ai.env (mode 600; directory 700) and fill in the key.
# Never commit the real file. $GOA_SECRETS_DIR overrides the folder; environment variables override the values.
AZURE_AI_ENDPOINT=https://onyx-ai-swe.services.ai.azure.com/openai/v1
AZURE_AI_KEY=
AZURE_SOL_MODEL=gpt-6.1-sol
AZURE_IMAGE_MODEL=gpt-image-2.5-sunburst-Global
# Rate limits of the deployments (requests wait when a minute's budget is used; HTTP 429 waits a minute):
AZURE_SOL_TPM=333000
AZURE_IMAGES_PM=4
