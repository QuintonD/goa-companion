<?xml version="1.0" encoding="utf-8"?>
<!--
  Group sync (ADR-025): phone to phone over Google Nearby Connections. Permissions as
  developers.google.com/nearby/connections/android/get-started lists them (checked 2026-10-17), with
  the changes noted below; the app asks for the runtime ones only when a sync starts. Nearby needs no INTERNET
  permission; the app's manifest declares it for the group's sync server (ADR-036).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google's list caps these two at 31, but Play services' Nearby still checks ACCESS_WIFI_STATE
         on Android 12+ and refuses to advertise or discover without it (8032
         MISSING_PERMISSION_ACCESS_WIFI_STATE, seen on API 36, 2026-10-18). Both are install-time
         permissions with no prompt, so they are declared on every version. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Google's list stops COARSE at 28, but Android 12 (31) ignores a FINE request that
         comes without COARSE (lint CoarseFineLocation), so COARSE is declared and asked up to 31. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="31" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="31"
        tools:targetApi="29" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />
    <!-- neverForLocation: without it Play services' Nearby refuses to discover unless the app also holds
         COARSE and FINE location on Android 12+ (8034, then 8036 MISSING_PERMISSION_ACCESS_FINE_LOCATION);
         with it, discovery and a full sync ran with no location permission (API 36 emulators, 2026-10-18). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="32" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:targetApi="37" />

    <application>
        <!-- Hands "Share sync file" to the share sheet; files live in cache/sync/ only. -->
        <provider
            android:name="dev.quinton.goa.feature.sync.share.SyncFileProvider"
            android:authorities="${applicationId}.syncfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sync_file_paths" />
        </provider>
    </application>
</manifest>
